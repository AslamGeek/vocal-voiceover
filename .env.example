GEMINI_API_KEY=
# Optional ordered pool. When non-empty, this takes precedence over GEMINI_API_KEY.
GEMINI_API_KEYS=
# Enable only if EVERY key belongs to a different, independently eligible project.
GEMINI_API_KEYS_INDEPENDENT_PROJECTS=false
# Optional failover on temporary 500/502/503/504 responses after backoff.
GEMINI_API_FAILOVER_ON_TRANSIENT_ERRORS=false
